package br.com.senaisp.bauru;


import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.layout.StackPane;
import javafx.scene.layout.TilePane;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class JavaFXExemplo01 extends Application {

	@Override
	public void start(Stage primaryStage) throws Exception {
		Button btn1 = new Button("Botão dos Sonhos");
		Button btn2 = new Button("Talvez o botão dos sonhos");
		// Posicionando botões - Eixo X
		btn1.setLayoutX(10);
		btn2.setLayoutX(150);
		//Eixo Y
		btn1.setLayoutY(10);
		btn2.setLayoutY(150);
		//Criando o container
		//StackPane root = new StackPane();
		//TilePane root = new TilePane();
		VBox root = new TilePane();
		//Adicionando botões no painel
		root.getChildren().addAll(btn1, btn2);
		//Criando a Scene
		Scene cena = new Scene(root,600,800);
		//Amarrando a cena na tela
		primaryStage.setTitle("Titulo da Janela");
		primaryStage.setScene(cena);
		primaryStage.show();
	}

	public static void main(String[] args) {
		launch(args);
	}

}
